# Copy this file to .env and fill in real values. Never commit .env.
# Leave SECRET_KEY empty in development to auto-generate a random one per run,
# or set a long random string so tokens survive a server restart.
SECRET_KEY=
DATABASE_URL=sqlite:///./aipulse.db
AI_MODE=mock
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
