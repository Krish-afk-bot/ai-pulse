# Copy this file to .env and fill in real values. Never commit .env.

# Signs login tokens. Must be at least 32 bytes. Leave empty in development to
# auto-generate a random one per run (tokens then do not survive a restart).
SECRET_KEY=
# Where data is stored; the default is a local SQLite file.
DATABASE_URL=sqlite:///./aipulse.db
# "mock" scores open answers with canned responses; "live" calls the real API.
AI_MODE=mock
# Only used when AI_MODE=live: the OpenAI-compatible chat completions endpoint.
LLM_API_URL=
# Only used when AI_MODE=live: the API key for that endpoint.
LLM_API_KEY=
# Only used when AI_MODE=live: the model name to request.
LLM_MODEL=
# scrypt cost for password hashing; 16384 is the production default.
SCRYPT_N=16384
